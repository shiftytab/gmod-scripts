@name STUNSTICK
@outputs AimTarget:entity CurrentTarget:entity TargetPos:vector
@persist AimTarget:entity CurrentTarget:entity TargetPos:vector HasTarget:number
@trigger

runOnTick(1)

O = owner()
STAFF = "weapon_stunstick"
AIM_STAFF = (O:weapon():type() == STAFF)

function findTarget() {
    if (O & AIM_STAFF) {
        AimTarget = O:aimEntity()

        if (AimTarget:isValid()) {
            CurrentTarget = AimTarget
            HasTarget = 1
            
            if (CurrentTarget:isPlayer()) {
                print("Player selected: " + CurrentTarget:name())
            } else {
                print("Target selected: " + CurrentTarget:id())
            }
        } 
        else {
            CurrentTarget = noentity()
            TargetPos = O:aimPos()
            if(HasTarget == 0) {
                print("Position selected: " + TargetPos)
            }
            HasTarget = 1
            
        }
    }
}


if (O:keyAttack1()) {
    findTarget()
}

if (O:keyAttack2()) {
    if (AIM_STAFF & HasTarget) {
        CurrentTarget = noentity()
        TargetPos = vec()
        HasTarget = 0
        print("Target unselected")
    }
}

if (first()) {
    print("Ready to serve !")
    entity():setAlpha(0)
}


if (HasTarget) {
    SpawnPos = CurrentTarget:isValid() ? CurrentTarget:pos() : TargetPos
    
    P = propSpawn("models/props_c17/oildrum001_explosive.mdl", SpawnPos, 1)
    P:propBreak()
}
